# Copy to `.env` (gitignored) and fill in. Never commit real values.
#
# Locally you can instead use a ~/.databrickscfg profile named DEFAULT, which is
# what the local tooling prefers; these variables are the fallback and are what
# you configure as secrets when running in a cloud sandbox.

DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=

# Serverless SQL warehouse used for all verification queries.
DATABRICKS_WAREHOUSE_ID=

# Workspace folder holding the notebooks (source of truth for the running pipeline).
DATABRICKS_NOTEBOOK_PATH=/Workspace/Users/

# Unity Catalog target.
DATABRICKS_CATALOG=market_data
DATABRICKS_SCHEMA=nso
